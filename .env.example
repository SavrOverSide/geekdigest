# Токен бота дайджеста от @BotFather (бот должен быть админом канала)
BOT_TOKEN=
CHANNEL=@geekdigests
# Необязательно: канал английского выпуска (создай канал, добавь бота админом). Пусто = английский выпуск только в личку
CHANNEL_EN=
# Время поста по Казахстану
DIGEST_TIME=09:00
# Необязательно: ключ Anthropic API, тогда вместо заголовков будут пересказы
ANTHROPIC_API_KEY=
